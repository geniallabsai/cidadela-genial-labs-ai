#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""genial — Genial Labs: a arquitetura que guia seu código.

Comandos:
  genial               banner + resumo
  genial banner        arte GENIAL LABS (azul tech)
  genial init [DIR]    projeto novo: arquitetura de dados + skeleton + Docker/compose/k8s + gates CI
  genial doctor        auditoria do projeto atual (roda a skill cidadela — Fase 0)
  genial skills        lista skills instaladas (Codex / Claude Code)
  genial deploy        degrau atual de infraestrutura (0–5) + próximo passo
  genial update        atualiza o pacote
  genial uninstall     remove tudo que o instalador colocou
"""
import argparse
import datetime
import os
import shutil
import subprocess
import sys

VERSAO = "1.0.2"
REPO_GIT = "https://github.com/brunao23/genial-labs.git"
INSTALL_CMD = "curl -fsSL https://raw.githubusercontent.com/brunao23/genial-labs/main/install.sh | bash"


def _cor(num):
    if os.environ.get("NO_COLOR") or not sys.stdout.isatty():
        return lambda s: s
    return lambda s: "\033[%sm%s\033[0m" % (num, s)


